            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-07-06 18:11:03</dcterms:dateSubmitted>
        <dc:rights>http://www.nrcresearchpress.com/page/about/CorporateTextAndDataMining</dc:rights>
        <bib:pages>649-653</bib:pages>
    </bib:Article>
