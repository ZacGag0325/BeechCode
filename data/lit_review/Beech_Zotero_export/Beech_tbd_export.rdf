            <dcterms:URI>
                <rdf:value>https://cdnsciencepub.com/doi/10.1139/cjfr-2017-0233</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-07-06 18:13:11</dcterms:dateSubmitted>
        <bib:pages>23-31</bib:pages>
    </bib:Article>
