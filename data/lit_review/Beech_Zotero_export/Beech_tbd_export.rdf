                <rdf:value>https://academic.oup.com/njaf/article/24/1/14/4780103</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-07-06 18:11:48</dcterms:dateSubmitted>
        <bib:pages>14-21</bib:pages>
    </bib:Article>
