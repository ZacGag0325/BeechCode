            <dcterms:URI>
                <rdf:value>https://cdnsciencepub.com/doi/10.1139/cjfr-2020-0339</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-07-06 18:13:12</dcterms:dateSubmitted>
        <bib:pages>1080-1091</bib:pages>
    </bib:Article>
