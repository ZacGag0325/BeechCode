            <dcterms:URI>
                <rdf:value>https://esajournals.onlinelibrary.wiley.com/doi/10.2307/1940219</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2024-10-11 14:33:32</dcterms:dateSubmitted>
