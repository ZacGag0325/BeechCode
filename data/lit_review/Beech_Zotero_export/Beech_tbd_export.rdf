            <dcterms:URI>
                <rdf:value>https://cdnsciencepub.com/doi/10.1139/cjfr-2024-0053</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-07-06 18:15:12</dcterms:dateSubmitted>
        <bib:pages>1270-1281</bib:pages>
    </bib:Article>
