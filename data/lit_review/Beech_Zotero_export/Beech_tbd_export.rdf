            <dcterms:URI>
                <rdf:value>https://academic.oup.com/njaf/article/5/4/261/4802992</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-07-06 18:11:33</dcterms:dateSubmitted>
        <bib:pages>261-262</bib:pages>
    </bib:Article>
