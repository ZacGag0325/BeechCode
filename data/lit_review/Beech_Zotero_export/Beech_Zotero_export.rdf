            <dcterms:URI>
               <rdf:value>https://www.mdpi.com/2071-1050/15/9/7490</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-07-06 18:10:42</dcterms:dateSubmitted>
        <bib:pages>7490</bib:pages>
